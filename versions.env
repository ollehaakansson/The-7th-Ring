# The .NET ("mono") flavour is required - the plain build cannot run C#.
GODOT_VERSION=4.7.2
GODOT_RELEASE=stable

# .NET SDK. Godot 4.7.2 refuses to load its C# tooling without 10.0.7+;
# the engine error is ".NET Sdk not found. The required version is 10.0.7".
DOTNET_SDK_VERSION=10.0.7

# Set to 1 to also download export templates (~1 GB, only needed to build
# a distributable .exe/.app - not needed for day-to-day development).
GODOT_EXPORT_TEMPLATES=0
