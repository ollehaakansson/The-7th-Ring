root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.cs]
indent_style = tab
indent_size = 4
csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true

[*.{json,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.{tscn,tres,godot,import}]
indent_style = tab
trim_trailing_whitespace = false

[*.ps1]
end_of_line = crlf
indent_style = space
indent_size = 4
